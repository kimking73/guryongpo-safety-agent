# Mock is the safe default. remote = 실제 서버 연결 (docker compose up 후)
APP_MODE=mock
# 서버 주소 (비우면 로컬 기본값). 배포는 세 값 모두 같은 도메인 (Caddy가 경로로 나눔)
API_BASE_URL=http://localhost:8000
AI_BASE_URL=http://localhost:8001
ROUTE_BASE_URL=http://localhost:8002
# Do not commit real Firebase configuration. Pass values as --dart-define instead.
# FIREBASE_API_KEY=...
# FIREBASE_APP_ID=...
# FIREBASE_PROJECT_ID=...
# FIREBASE_MESSAGING_SENDER_ID=...
