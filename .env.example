# 복사해서 사용:  cp .env.example .env
# 규칙
# - .env는 절대 커밋하지 않는다 (.gitignore에 등록됨).
# - 새 키를 추가하면 같은 커밋에서 이 파일에도 추가한다 (값은 비우거나 로컬 기본값).
# - 이름은 대문자 스네이크 + 영역 접두사: DB_, API_, GCP_, FIREBASE_, OPENAI_, ROUTE_, GRAPHHOPPER_, KMA_, POHANG_TWIN_, SAFETY24_, KAKAO_
# - 실제 키 값은 팀 비공개 채널로만 공유한다. 저장소·이슈·PR에 붙이지 않는다.
# - 파일로 된 비밀(서비스 계정 JSON)은 secrets/에 두고 여기에는 경로만 쓴다.
# - 주석은 반드시 별도 줄에. 값 뒤에 붙이면 docker가 주석까지 값으로 읽는다.

# --- DB (PostgreSQL + PostGIS) ---
DB_USER=guardian
DB_PASSWORD=guardian-local-only
DB_NAME=guardian
# 로컬에서 접속할 포트 (컨테이너 안은 5432)
DB_HOST_PORT=5433
# AI(ai 컨테이너) 전용 읽기 전용 계정 — db/init/07_ai_readonly.sh가 만든다. 서버에서는 비밀번호를 바꾼다
AI_DB_USER=guardian_ai
AI_DB_PASSWORD=guardian-ai-local-only
# AI 대화·사용자 기억 저장 계정 — db/init/08_ai_memory.sh가 만든다 (ai_memory 스키마만 쓸 수 있음). 서버에서는 비밀번호를 바꾼다
AI_MEM_DB_USER=guardian_ai_mem
AI_MEM_DB_PASSWORD=guardian-ai-mem-local-only

# --- API (FastAPI, server/) ---
API_PORT=8000
# 인증 방식: firebase (배포·기본) / dev ('Authorization: Bearer dev:<아무 uid>' 도 허용 — 로컬·목업 연동용, 배포 금지)
API_AUTH_MODE=dev
# /api/v1/internal/* (수집 수동 실행·시연 시나리오) 호출용 비밀값, 헤더 X-Internal-Token. 만들기: openssl rand -hex 16
# 비우면 dev 모드에서만 허용, firebase 모드에서는 전부 거절
API_INTERNAL_TOKEN=
# 브라우저(Flutter 웹)에서 호출을 허용할 출처, 쉼표 구분. api·ai·route 공통. 비우면 * (모두 허용)
CORS_ORIGINS=

# --- GCP / Firebase ---
GCP_PROJECT_ID=guryong-guardian-0924
GCP_REGION=asia-northeast3
# 서비스 계정 키 (팀 비공개 채널로 받기)
FIREBASE_CREDENTIALS=secrets/firebase-admin.json

# --- AI (ai 컨테이너) ---
# OpenAI API 키 (platform.openai.com → API keys). 대시보드에서 프로젝트 월 사용 한도를 꼭 건다
OPENAI_API_KEY=
# 가성비 기준 gpt-6-luna. 부족한 단계만 gpt-6.1-sol로 올린다
OPENAI_MODEL=gpt-6-luna
# 환각 검증(내용 검사)에만 다른 모델을 쓸 때 (비우면 OPENAI_MODEL). 예: gpt-6.1-sol
OPENAI_VERIFY_MODEL=
# OpenAI 응답 제한(ms). 넘으면 키워드 분류로 대체. 기본 10000
OPENAI_TIMEOUT_MS=10000
# 월 예산(원). 예상 비용이 50·80·100%를 넘으면 ai 로그에 경고 (호출은 막지 않음). 현황: GET /api/ai/usage
OPENAI_BUDGET_KRW=200000
AI_PORT=8001

# --- 경로 안내 (route 컨테이너, GraphHopper) ---
ROUTE_PORT=8002
# GraphHopper 응답 제한(ms). 넘으면 503. 기본 5000
GRAPHHOPPER_TIMEOUT_MS=5000
# 경로가 피할 위험지역을 고정 GeoJSON 파일로 줄 때만 (시연·테스트, 예: /app/data/hazards.sample.geojson). 비우면 판정 엔진의 현재 침수·산사태 영역(주의 이상)
ROUTE_HAZARDS_FILE=

# --- 데이터 수집기 (collector 컨테이너, A2) ---
# live = 실제 API 호출 / replay = server/mock/external 의 저장 원문으로 적재 (네트워크·키 없이 개발·시연)
COLLECTOR_FETCH_MODE=live
# true 면 api 컨테이너 안에서도 스케줄러 실행 (collector 없이 돌릴 때만. 둘 다 켜면 중복 수집)
COLLECTOR_IN_API=false

# --- 외부 데이터 API (A2에서 사용) ---
# 기상청 API허브 authKey (apihub.kma.go.kr — 동네예보·특보·AWS·태풍·중기예보)
KMA_API_KEY=
# 포항 디지털 트윈 serviceKey
POHANG_TWIN_API_KEY=
POHANG_TWIN_BASE_URL=https://genix.pohang-eum.kr/dpg
# 재난안전24
SAFETY24_API_KEY=

# --- 장소 검색 (ai 컨테이너, 위치·경로 agent의 목적지 찾기) ---
# 카카오 developers REST API 키 (내 애플리케이션 → 앱 키 → REST API 키, 카카오맵 사용 설정 ON). 비우면 등록 장소·대피소 이름만 찾는다
KAKAO_REST_KEY=
