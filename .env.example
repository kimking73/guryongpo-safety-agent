# 복사해서 사용:  cp .env.example .env
# 규칙
# - .env는 절대 커밋하지 않는다 (.gitignore에 등록됨).
# - 새 키를 추가하면 같은 커밋에서 이 파일에도 추가한다 (값은 비우거나 로컬 기본값).
# - 이름은 대문자 스네이크 + 영역 접두사: DB_, API_, GCP_, FIREBASE_, GEMINI_, KMA_, POHANG_TWIN_, SAFETY24_
# - 실제 키 값은 팀 비공개 채널로만 공유한다. 저장소·이슈·PR에 붙이지 않는다.
# - 파일로 된 비밀(서비스 계정 JSON)은 secrets/에 두고 여기에는 경로만 쓴다.
# - 주석은 반드시 별도 줄에. 값 뒤에 붙이면 docker가 주석까지 값으로 읽는다.

# --- DB (PostgreSQL + PostGIS) ---
DB_USER=guardian
DB_PASSWORD=guardian-local-only
DB_NAME=guardian
# 로컬에서 접속할 포트 (컨테이너 안은 5432)
DB_HOST_PORT=5433

# --- API (FastAPI) ---
API_PORT=8000

# --- GCP / Firebase ---
GCP_PROJECT_ID=guryong-guardian-0924
GCP_REGION=asia-northeast3
# 서비스 계정 키 (팀 비공개 채널로 받기)
FIREBASE_CREDENTIALS=secrets/firebase-admin.json

# --- AI (ai 컨테이너) ---
# AI Studio에서 guryong-guardian-0924 프로젝트로 발급
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Gemini 응답 제한(ms). 넘으면 키워드 분류로 대체. 기본 10000
GEMINI_TIMEOUT_MS=10000
AI_PORT=8001

# --- 외부 데이터 API (A2에서 사용) ---
# 기상청 (공공데이터포털)
KMA_API_KEY=
# 포항 디지털 트윈
POHANG_TWIN_API_KEY=
# 재난안전24
SAFETY24_API_KEY=
