# 비밀 값 (절대 커밋 금지)
.env
.env.*
!.env.example
secrets/*
!secrets/.gitkeep
# 개발 스크립트(server/tools)용 API 키 파일
dt_config.txt

# 기획서 등 문서 원본 (저장소 밖에서 관리)
*.docx
*.pptx
*.pdf

# OS·에디터
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# GraphHopper 캐시·지도 원본 (B6에서 생성, 용량 큼)
graphhopper/data/
*.osm.pbf

# 국토지리정보원 DEM 원본 (B7, 용량 큼). graphhopper/dem/README.md 참고
graphhopper/dem/ngii/

# 수집 원문 중 용량이 큰 것 (server/tools/fetch_dt.py 가 만듦. 필요한 것만 골라 커밋)
server/mock/external/safemap_*
server/mock/external/kma_aws_min_all.txt
server/mock/external/kma_aws_stnlist_*.json
server/mock/external/kma_awsh_wind.txt
server/mock/external/geocode_log.json
# 경로 시연 산출물 (route/scripts/avoid_demo.py)
route/out/
